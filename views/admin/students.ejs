<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> - School Management</title>
<link rel="stylesheet" href="/css/style2.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
    .filter-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 10px;
    }

    .filter-bar input[type="text"] {
        padding: 8px 12px;
        border: 1px solid #ccc;
        border-radius: 6px;
        width: 250px;
        font-size: 14px;
    }

    /* Section Headers */
    .section-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 15px 20px;
        border-radius: 10px;
        margin: 30px 0 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .section-header:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 12px rgba(0,0,0,0.15);
    }

    .section-header h2 {
        margin: 0;
        font-size: 24px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .section-header .toggle-icon {
        transition: transform 0.3s;
    }

    .section-header.collapsed .toggle-icon {
        transform: rotate(-90deg);
    }

    .section-count {
        background: rgba(255,255,255,0.2);
        padding: 5px 15px;
        border-radius: 20px;
        font-size: 14px;
    }

    /* Class Headers */
    .class-header {
        background: #2a5298;
        color: white;
        padding: 12px 20px;
        border-radius: 8px;
        margin: 15px 0 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        transition: all 0.3s;
    }

    .class-header:hover {
        background: #1e3c72;
    }

    .class-header h3 {
        margin: 0;
        font-size: 18px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .class-header .toggle-icon {
        transition: transform 0.3s;
    }

    .class-header.collapsed .toggle-icon {
        transform: rotate(-90deg);
    }

    .class-count {
        background: rgba(255,255,255,0.2);
        padding: 3px 12px;
        border-radius: 15px;
        font-size: 13px;
    }

    /* Section and Class Content */
    .section-content,
    .class-content {
        overflow: hidden;
        transition: max-height 0.4s ease-out, opacity 0.3s ease-out;
        max-height: 5000px;
        opacity: 1;
    }

    .section-content.collapsed,
    .class-content.collapsed {
        max-height: 0;
        opacity: 0;
        margin: 0;
    }

    /* Profile Photo Styles */
    .student-photo {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #2a5298;
    }

    .student-photo-placeholder {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
        font-size: 20px;
        border: 2px solid #2a5298;
    }

    .student-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .student-details {
        text-align: left;
    }

    .student-name {
        font-weight: 600;
        color: #2a5298;
        margin-bottom: 3px;
    }

    .student-reg {
        font-size: 12px;
        color: #666;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
    }

    table td {
        vertical-align: middle;
    }

    .text-center {
        text-align: center;
    }

    .no-students-msg {
        padding: 20px;
        text-align: center;
        color: #666;
        font-style: italic;
        background: #f8f9fa;
        border-radius: 6px;
        margin: 10px 0;
    }
</style>
</head>
<body>
<div class="admin-layout">
    <%- include('../partials/sidebar') %>

    <div class="main-content">
      <header>
        <button class="menu-btn" id="menuBtn">
          <i class="fa fa-bars"></i>
        </button>
        <h1>Students Management</h1>
      </header>

      <main class="admin-content">
        <% if (success) { %>
            <div class="alert alert-success">
                <i class="fa fa-check-circle"></i> <%= success %>
            </div>
        <% } %>
        
        <% if (error) { %>
            <div class="alert alert-error">
                <i class="fa fa-exclamation-circle"></i> <%= error %>
            </div>
        <% } %>

        <section class="page-actions">
            <a href="/admin/students/add" class="btn btn-primary">
                <i class="fa fa-plus"></i> Add New Student
            </a>
        </section>

        <div class="filter-bar">
            <div>
                <input type="text" id="searchInput" placeholder="Search by name, class, or reg number...">
            </div>
        </div>

        <%
          // Group students by section and class
          const jssClasses = ['JSS 1', 'JSS 2', 'JSS 3'];
          const sssClasses = ['SSS 1', 'SSS 2', 'SSS 3'];
          
          const jssStudents = students.filter(s => s.classLevel.startsWith('JSS'));
          const sssStudents = students.filter(s => s.classLevel.startsWith('SSS') || s.classLevel.startsWith('SS'));
          
          function getStudentsByClass(students, className) {
            return students.filter(s => s.classLevel === className);
          }
        %>

        <!-- JSS SECTION -->
        <div class="section-header collapsed" onclick="toggleSection(this)">
            <h2>
                <i class="fa fa-graduation-cap"></i>
                Junior Secondary School (JSS)
            </h2>
            <div style="display: flex; align-items: center; gap: 15px;">
                <span class="section-count"><%= jssStudents.length %> Students</span>
                <i class="fa fa-chevron-down toggle-icon"></i>
            </div>
        </div>

        <div class="section-content collapsed">
            <% jssClasses.forEach(className => { %>
                <% const classStudents = getStudentsByClass(jssStudents, className); %>
                
                <div class="class-header collapsed" onclick="toggleClass(this)">
                    <h3>
                        <i class="fa fa-users"></i>
                        <%= className %>
                    </h3>
                    <div style="display: flex; align-items: center; gap: 15px;">
                        <span class="class-count"><%= classStudents.length %> Students</span>
                        <i class="fa fa-chevron-down toggle-icon"></i>
                    </div>
                </div>

                <div class="class-content collapsed">
                    <% if (classStudents.length === 0) { %>
                        <div class="no-students-msg">No students in this class</div>
                    <% } else { %>
                        <section class="table-container">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Student</th>
                                        <th>Gender</th>
                                        <th>Session</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% classStudents.forEach(student => { %>
                                        <tr class="student-row" 
                                            data-name="<%= student.name %>" 
                                            data-reg="<%= student.regNumber %>" 
                                            data-class="<%= student.classLevel %>">
                                            <td>
                                                <div class="student-info">
                                                    <% if (student.profilePhoto) { %>
                                                        <img src="<%= student.profilePhoto %>" 
                                                             alt="<%= student.name %>" 
                                                             class="student-photo">
                                                    <% } else { %>
                                                        <div class="student-photo-placeholder">
                                                            <%= student.name.charAt(0).toUpperCase() %>
                                                        </div>
                                                    <% } %>
                                                    <div class="student-details">
                                                        <div class="student-name"><%= student.name %></div>
                                                        <div class="student-reg">REG: <%= student.regNumber %></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><%= student.gender %></td>
                                            <td><%= student.session %></td>
                                            <td class="actions">
                                                <a href="/admin/students/edit/<%= student._id %>" 
                                                   class="btn btn-sm btn-edit">
                                                    <i class="fa fa-edit"></i> Edit
                                                </a>
                                                <form action="/admin/students/delete/<%= student._id %>" 
                                                      method="POST" 
                                                      style="display:inline;" 
                                                      onsubmit="return confirm('Delete <%= student.name %>?');">
                                                    <button type="submit" class="btn btn-sm btn-delete">
                                                        <i class="fa fa-trash"></i> Delete
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </section>
                    <% } %>
                </div>
            <% }); %>
        </div>

        <!-- SSS SECTION -->
        <div class="section-header collapsed" onclick="toggleSection(this)">
            <h2>
                <i class="fa fa-graduation-cap"></i>
                Senior Secondary School (SSS)
            </h2>
            <div style="display: flex; align-items: center; gap: 15px;">
                <span class="section-count"><%= sssStudents.length %> Students</span>
                <i class="fa fa-chevron-down toggle-icon"></i>
            </div>
        </div>

        <div class="section-content collapsed">
            <% sssClasses.forEach(className => { %>
                <% const classStudents = getStudentsByClass(sssStudents, className); %>
                
                <div class="class-header" onclick="toggleClass(this)">
                    <h3>
                        <i class="fa fa-users"></i>
                        <%= className %>
                    </h3>
                    <div style="display: flex; align-items: center; gap: 15px;">
                        <span class="class-count"><%= classStudents.length %> Students</span>
                        <i class="fa fa-chevron-down toggle-icon"></i>
                    </div>
                </div>

                <div class="class-content">
                    <% if (classStudents.length === 0) { %>
                        <div class="no-students-msg">No students in this class</div>
                    <% } else { %>
                        <section class="table-container">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Student</th>
                                        <th>Gender</th>
                                        <th>Session</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% classStudents.forEach(student => { %>
                                        <tr class="student-row" 
                                            data-name="<%= student.name %>" 
                                            data-reg="<%= student.regNumber %>" 
                                            data-class="<%= student.classLevel %>">
                                            <td>
                                                <div class="student-info">
                                                    <% if (student.profilePhoto) { %>
                                                        <img src="<%= student.profilePhoto %>" 
                                                             alt="<%= student.name %>" 
                                                             class="student-photo">
                                                    <% } else { %>
                                                        <div class="student-photo-placeholder">
                                                            <%= student.name.charAt(0).toUpperCase() %>
                                                        </div>
                                                    <% } %>
                                                    <div class="student-details">
                                                        <div class="student-name"><%= student.name %></div>
                                                        <div class="student-reg">REG: <%= student.regNumber %></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><%= student.gender %></td>
                                            <td><%= student.session %></td>
                                            <td class="actions">
                                                <a href="/admin/students/edit/<%= student._id %>" 
                                                   class="btn btn-sm btn-edit">
                                                    <i class="fa fa-edit"></i> Edit
                                                </a>
                                                <form action="/admin/students/delete/<%= student._id %>" 
                                                      method="POST" 
                                                      style="display:inline;" 
                                                      onsubmit="return confirm('Delete <%= student.name %>?');">
                                                    <button type="submit" class="btn btn-sm btn-delete">
                                                        <i class="fa fa-trash"></i> Delete
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </section>
                    <% } %>
                </div>
            <% }); %>
        </div>

      </main>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Sidebar toggle
    const menuBtn = document.getElementById('menuBtn');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.createElement('div');
    overlay.className = 'sidebar-overlay';
    document.body.appendChild(overlay);

    menuBtn.addEventListener('click', () => {
        sidebar.classList.toggle('active');
        overlay.classList.toggle('active');
    });
    
    overlay.addEventListener('click', () => {
        sidebar.classList.remove('active');
        overlay.classList.remove('active');
    });

    // Auto-hide alerts
    const alerts = document.querySelectorAll('.alert');
    alerts.forEach(alert => {
        setTimeout(() => {
            alert.style.transition = 'opacity 0.5s';
            alert.style.opacity = '0';
            setTimeout(() => alert.remove(), 500);
        }, 5000);
    });

    // Search functionality
    const searchInput = document.getElementById('searchInput');
    
    searchInput.addEventListener('input', function() {
        const searchText = this.value.toLowerCase();
        const allRows = document.querySelectorAll('.student-row');
        
        allRows.forEach(row => {
            const name = row.dataset.name.toLowerCase();
            const reg = row.dataset.reg.toLowerCase();
            const className = row.dataset.class.toLowerCase();
            
            if (name.includes(searchText) || reg.includes(searchText) || className.includes(searchText)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });

        // Update counts after search
        updateCounts();
    });
});

function toggleSection(element) {
    const content = element.nextElementSibling;
    element.classList.toggle('collapsed');
    content.classList.toggle('collapsed');
}

function toggleClass(element) {
    const content = element.nextElementSibling;
    element.classList.toggle('collapsed');
    content.classList.toggle('collapsed');
}

function updateCounts() {
    // Update section counts
    document.querySelectorAll('.section-header').forEach(header => {
        const section = header.nextElementSibling;
        const visibleRows = section.querySelectorAll('.student-row:not([style*="display: none"])');
        const countSpan = header.querySelector('.section-count');
        countSpan.textContent = `${visibleRows.length} Students`;
    });

    // Update class counts
    document.querySelectorAll('.class-header').forEach(header => {
        const classContent = header.nextElementSibling;
        const visibleRows = classContent.querySelectorAll('.student-row:not([style*="display: none"])');
        const countSpan = header.querySelector('.class-count');
        countSpan.textContent = `${visibleRows.length} Students`;
    });
}
</script>
</body>
</html>
