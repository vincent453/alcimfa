<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> - School Management</title>
<link rel="stylesheet" href="/css/style2.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
    .filter-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 10px;
    }

    .filter-bar input[type="text"] {
        padding: 8px 12px;
        border: 1px solid #ccc;
        border-radius: 6px;
        width: 250px;
        font-size: 14px;
    }

    .filter-bar select {
        padding: 8px 12px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 14px;
    }

    .filter-bar label {
        font-weight: 600;
        margin-right: 6px;
    }

    .table-container table {
        width: 100%;
        border-collapse: collapse;
    }

    .text-center {
        text-align: center;
    }

    /* Profile Photo Styles */
    .student-photo {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #2a5298;
    }

    .student-photo-placeholder {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
        font-size: 20px;
        border: 2px solid #2a5298;
    }

    .student-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .student-details {
        text-align: left;
    }

    .student-name {
        font-weight: 600;
        color: #2a5298;
        margin-bottom: 3px;
    }

    .student-reg {
        font-size: 12px;
        color: #666;
    }

    table td {
        vertical-align: middle;
    }
</style>
</head>
<body>
<div class="admin-layout">
    <!-- Sidebar -->
    <%- include('../partials/sidebar') %>

    <!-- Main Content -->
    <div class="main-content">
      <header>
        <button class="menu-btn" id="menuBtn">
          <i class="fa fa-bars"></i>
        </button>
        <h1>Students Management</h1>
      </header>

      <main class="admin-content">
        <% if (success) { %>
            <div class="alert alert-success">
                <i class="fa fa-check-circle"></i> <%= success %>
            </div>
        <% } %>
        
        <% if (error) { %>
            <div class="alert alert-error">
                <i class="fa fa-exclamation-circle"></i> <%= error %>
            </div>
        <% } %>

        <section class="page-actions">
            <a href="/admin/students/add" class="btn btn-primary">
                <i class="fa fa-plus"></i> Add New Student
            </a>
        </section>

        <!-- 🔍 Filter and Sorting Controls -->
        <div class="filter-bar">
            <div>
                <input type="text" id="searchInput" placeholder="Search by name, class, or reg number...">
            </div>
            <div>
                <label for="sortSelect">Sort by:</label>
                <select id="sortSelect">
                    <option value="">-- Select --</option>
                    <option value="name-asc">Name (A–Z)</option>
                    <option value="name-desc">Name (Z–A)</option>
                    <option value="class-asc">Class (A–Z)</option>
                    <option value="class-desc">Class (Z–A)</option>
                    <option value="session-asc">Session (Oldest–Newest)</option>
                    <option value="session-desc">Session (Newest–Oldest)</option>
                </select>
            </div>
        </div>

        <section class="table-container">
            <table id="studentTable">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Class</th>
                        <th>Gender</th>
                        <th>Session</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (students.length === 0) { %>
                        <tr>
                            <td colspan="5" class="text-center">No students found</td>
                        </tr>
                    <% } else { %>
                        <% students.forEach(student => { %>
                            <tr>
                                <td>
                                    <div class="student-info">
                                        <% if (student.profilePhoto) { %>
                                            <img src="<%= student.profilePhoto %>" 
                                                 alt="<%= student.name %>" 
                                                 class="student-photo">
                                        <% } else { %>
                                            <div class="student-photo-placeholder">
                                                <%= student.name.charAt(0).toUpperCase() %>
                                            </div>
                                        <% } %>
                                        <div class="student-details">
                                            <div class="student-name"><%= student.name %></div>
                                            <div class="student-reg">REG: <%= student.regNumber %></div>
                                        </div>
                                    </div>
                                </td>
                                <td><%= student.classLevel %></td>
                                <td><%= student.gender %></td>
                                <td><%= student.session %></td>
                                <td class="actions">
                                    <a href="/admin/students/edit/<%= student._id %>" 
                                       class="btn btn-sm btn-edit"
                                       title="Edit Student">
                                        <i class="fa fa-edit"></i> Edit
                                    </a>
                                    <form action="/admin/students/delete/<%= student._id %>" 
                                          method="POST" 
                                          style="display:inline;" 
                                          onsubmit="return confirm('Are you sure you want to delete <%= student.name %> and all associated data?');">
                                        <button type="submit" 
                                                class="btn btn-sm btn-delete"
                                                title="Delete Student">
                                            <i class="fa fa-trash"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
        </section>
      </main>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Sidebar toggle
    const menuBtn = document.getElementById('menuBtn');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.createElement('div');
    overlay.className = 'sidebar-overlay';
    document.body.appendChild(overlay);

    menuBtn.addEventListener('click', () => {
        sidebar.classList.toggle('active');
        overlay.classList.toggle('active');
    });
    overlay.addEventListener('click', () => {
        sidebar.classList.remove('active');
        overlay.classList.remove('active');
    });

    // Close sidebar on link click (mobile)
    if (window.innerWidth <= 768) {
        const sidebarLinks = sidebar.querySelectorAll('a');
        sidebarLinks.forEach(link => {
            link.addEventListener('click', () => {
                sidebar.classList.remove('active');
                overlay.classList.remove('active');
            });
        });
    }

    // Auto-hide alerts after 5 seconds
    const alerts = document.querySelectorAll('.alert');
    alerts.forEach(alert => {
        setTimeout(() => {
            alert.style.transition = 'opacity 0.5s';
            alert.style.opacity = '0';
            setTimeout(() => alert.remove(), 500);
        }, 5000);
    });

    // 🔍 Search + Sort logic
    const searchInput = document.getElementById('searchInput');
    const sortSelect = document.getElementById('sortSelect');
    const tableBody = document.querySelector('#studentTable tbody');
    const rows = Array.from(tableBody.querySelectorAll('tr'));

    // Store original data for each row
    rows.forEach(row => {
        const studentInfo = row.querySelector('.student-info');
        if (studentInfo) {
            const nameElement = studentInfo.querySelector('.student-name');
            const regElement = studentInfo.querySelector('.student-reg');
            row.dataset.name = nameElement ? nameElement.textContent : '';
            row.dataset.reg = regElement ? regElement.textContent : '';
        }
    });

    function filterAndSort() {
        const searchText = searchInput.value.toLowerCase();
        const sortValue = sortSelect.value;

        // Filter
        const filteredRows = rows.filter(row => {
            // Skip the "no students" row
            if (row.cells.length < 5) return false;

            const name = (row.dataset.name || '').toLowerCase();
            const reg = (row.dataset.reg || '').toLowerCase();
            const classLevel = row.cells[1].textContent.toLowerCase();
            
            return (
                name.includes(searchText) ||
                classLevel.includes(searchText) ||
                reg.includes(searchText)
            );
        });

        // Sort
        filteredRows.sort((a, b) => {
            let aVal, bVal;

            switch (sortValue) {
                case 'name-asc':
                    aVal = a.dataset.name || '';
                    bVal = b.dataset.name || '';
                    return aVal.localeCompare(bVal);
                case 'name-desc':
                    aVal = a.dataset.name || '';
                    bVal = b.dataset.name || '';
                    return bVal.localeCompare(aVal);
                case 'class-asc':
                    aVal = a.cells[1].textContent;
                    bVal = b.cells[1].textContent;
                    return aVal.localeCompare(bVal);
                case 'class-desc':
                    aVal = a.cells[1].textContent;
                    bVal = b.cells[1].textContent;
                    return bVal.localeCompare(aVal);
                case 'session-asc':
                    aVal = a.cells[3].textContent;
                    bVal = b.cells[3].textContent;
                    return aVal.localeCompare(bVal);
                case 'session-desc':
                    aVal = a.cells[3].textContent;
                    bVal = b.cells[3].textContent;
                    return bVal.localeCompare(aVal);
                default:
                    return 0;
            }
        });

        // Re-render rows
        tableBody.innerHTML = '';
        if (filteredRows.length === 0) {
            tableBody.innerHTML = '<tr><td colspan="5" class="text-center">No students found matching your search</td></tr>';
        } else {
            filteredRows.forEach(row => tableBody.appendChild(row));
        }
    }

    searchInput.addEventListener('input', filterAndSort);
    sortSelect.addEventListener('change', filterAndSort);
});
</script>
</body>
</html>
