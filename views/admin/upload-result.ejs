<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Upload Result - School Management</title>
    <link rel="stylesheet" href="/css/style2.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <link href="https://fonts.cdnfonts.com/css/manrope" rel="stylesheet" />
    <style>
      .search-container {
        position: relative;
        margin-bottom: 10px;
        display: block;
      }
      
      .search-input {
        width: 100%;
        padding: 10px 40px 10px 15px;
        border: 2px solid #e0e0e0;
        border-radius: 5px;
        font-size: 14px;
        font-family: 'Manrope', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        transition: border-color 0.3s, box-shadow 0.3s;
        display: block;
        box-sizing: border-box;
      }
      
      .search-input:focus {
        outline: none;
        border-color: #2a5298;
        box-shadow: 0 0 0 3px rgba(42, 82, 152, 0.1);
      }
      
      .search-icon {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #2a5298;
        pointer-events: none;
        z-index: 1;
      }
      
      .clear-search {
        position: absolute;
        right: 40px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #888;
        cursor: pointer;
        font-size: 16px;
        display: none;
        padding: 5px;
        transition: color 0.3s;
        z-index: 2;
      }
      
      .clear-search:hover {
        color: #dc3545;
      }
      
      .clear-search.show {
        display: block;
      }
      
      .no-results {
        padding: 15px;
        color: #888;
        font-style: italic;
        display: none;
        background: #f8f9fa;
        border: 2px dashed #e0e0e0;
        border-radius: 5px;
        text-align: center;
      }
      
      .student-count {
        font-size: 12px;
        color: #666;
        margin-top: 5px;
        font-weight: 500;
        display: block;
      }

      /* Sort Controls */
      .sort-controls {
        display: flex;
        gap: 10px;
        margin-bottom: 10px;
        flex-wrap: wrap;
      }

      .sort-btn {
        padding: 8px 15px;
        border: 2px solid #e0e0e0;
        background: white;
        border-radius: 5px;
        cursor: pointer;
        font-size: 13px;
        font-family: 'Manrope', sans-serif;
        transition: all 0.3s;
        display: flex;
        align-items: center;
        gap: 5px;
      }

      .sort-btn:hover {
        border-color: #2a5298;
        background: #f8f9fa;
      }

      .sort-btn.active {
        background: #2a5298;
        color: white;
        border-color: #2a5298;
      }

      .sort-btn i {
        font-size: 12px;
      }

      /* Enhanced select dropdown */
      #studentId {
        max-height: 250px;
      }

      /* Mobile responsiveness for search */
      @media (max-width: 768px) {
        .search-input {
          font-size: 16px; /* Prevents zoom on iOS */
        }
        
        .sort-controls {
          gap: 5px;
        }
        
        .sort-btn {
          font-size: 12px;
          padding: 6px 12px;
        }
      }
    </style>
  </head>
  <body>
    <div class="admin-layout">
      <!-- Sidebar -->
    <%- include('../partials/sidebar') %>

    <!-- Main Content -->
    <div class="main-content">
      <header>
        <button class="menu-btn" id="menuBtn">
          <i class="fa fa-bars"></i>
        </button>
        <h1>Upload Result</h1>
      </header>
        <main class="admin-content">
          <section class="form-container">
            <form action="/api/results" method="POST" id="resultForm">
              <div class="form-row">
                <div class="form-group">
                  <label for="studentId">Select Student *</label>
                  
                  <!-- Sort Controls -->
                  <div class="sort-controls">
                    <button type="button" class="sort-btn active" data-sort="name-asc">
                      <i class="fa fa-sort-alpha-down"></i> Name (A-Z)
                    </button>
                    <button type="button" class="sort-btn" data-sort="name-desc">
                      <i class="fa fa-sort-alpha-up"></i> Name (Z-A)
                    </button>
                    <button type="button" class="sort-btn" data-sort="class-asc">
                      <i class="fa fa-sort-numeric-down"></i> Class
                    </button>
                    <button type="button" class="sort-btn" data-sort="reg-asc">
                      <i class="fa fa-hashtag"></i> Reg No.
                    </button>
                  </div>
                  
                  <!-- Search Input -->
                  <div class="search-container">
                    <input 
                      type="text" 
                      id="studentSearch" 
                      class="search-input"
                      placeholder="Search by name, class, or registration number..."
                      autocomplete="off"
                    />
                    <button type="button" class="clear-search" id="clearSearch">
                      <i class="fa fa-times"></i>
                    </button>
                    <i class="fa fa-search search-icon"></i>
                  </div>
                  
                  <select id="studentId" name="studentId" required>
                    <option value="">-- Select Student --</option>
                    <% students.forEach(student => { %>
                    <option value="<%= student._id %>" 
                            data-name="<%= student.name.toLowerCase() %>"
                            data-class="<%= student.classLevel.toLowerCase() %>"
                            data-reg="<%= student.regNumber.toLowerCase() %>"
                            data-display="<%= student.name %> - <%= student.classLevel %> (<%= student.regNumber %>)">
                      <%= student.name %> - <%= student.classLevel %> (<%= student.regNumber %>)
                    </option>
                    <% }); %>
                  </select>
                  
                  <div class="no-results" id="noResults">No students found</div>
                  <div class="student-count" id="studentCount"></div>
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="term">Term *</label>
                  <select id="term" name="term" required>
                    <option value="">Select Term</option>
                    <option value="1st Term">1st Term</option>
                    <option value="2nd Term">2nd Term</option>
                    <option value="3rd Term">3rd Term</option>
                  </select>
                </div>

                <div class="form-group">
                  <label for="session">Session *</label>
                  <input
                    type="text"
                    id="session"
                    name="session"
                    placeholder="e.g., 2024/2025"
                    required
                  />
                </div>
              </div>

              <h3>Subjects & Scores</h3>
              <div id="subjects-container">
                <div class="subject-entry">
                  <div class="form-row">
                    <div class="form-group">
                      <label>Subject Name *</label>
                      <input
                        type="text"
                        name="subjects[0][name]"
                        placeholder="e.g., Mathematics"
                        required
                      />
                    </div>

                    <div class="form-group">
                      <label>CA1 (0-15) *</label>
                      <input
                        type="number"
                        name="subjects[0][ca1]"
                        min="0"
                        max="15"
                        required
                      />
                    </div>

                    <div class="form-group">
                      <label>CA2 (0-15) *</label>
                      <input
                        type="number"
                        name="subjects[0][ca2]"
                        min="0"
                        max="15"
                        required
                      />
                    </div>

                    <div class="form-group">
                      <label>Exam (0-70) *</label>
                      <input
                        type="number"
                        name="subjects[0][exam]"
                        min="0"
                        max="70"
                        required
                      />
                    </div>

                    <div class="form-group">
                      <button
                        type="button"
                        onclick="removeSubject(this)"
                        class="btn btn-delete btn-sm"
                      >
                        <i class="fa fa-trash"></i>
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <button
                type="button"
                onclick="addSubject()"
                class="btn btn-secondary"
              >
                <i class="fa fa-plus"></i> Add Another Subject
              </button>

              <div class="form-group">
                <label for="teacherRemark">Teacher's Remark</label>
                <textarea
                  id="teacherRemark"
                  name="teacherRemark"
                  rows="3"
                  placeholder="Enter teacher's remark"
                ></textarea>
              </div>

              <div class="form-group">
                <label for="headRemark">Head of School's Remark</label>
                <textarea
                  id="headRemark"
                  name="headRemark"
                  rows="3"
                  placeholder="Enter head's remark"
                ></textarea>
              </div>

              <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                  <i class="fa fa-upload"></i> Upload Result
                </button>
                <a href="/admin/dashboard" class="btn btn-secondary">Cancel</a>
              </div>
            </form>
          </section>
        </main>
      </div>
    </div>

    <script>

      let subjectCount = 1;

      // Add new subject entry
      function addSubject() {
        const container = document.getElementById("subjects-container");
        const newSubject = document.createElement("div");
        newSubject.className = "subject-entry";
        newSubject.innerHTML = `
      <div class="form-row">
        <div class="form-group">
          <label>Subject Name *</label>
          <input type="text" name="subjects[${subjectCount}][name]" placeholder="e.g., English" required>
        </div>
        <div class="form-group">
          <label>CA1 (0-15) *</label>
          <input type="number" name="subjects[${subjectCount}][ca1]" min="0" max="15" required>
        </div>
        <div class="form-group">
          <label>CA2 (0-15) *</label>
          <input type="number" name="subjects[${subjectCount}][ca2]" min="0" max="15" required>
        </div>
        <div class="form-group">
          <label>Exam (0-70) *</label>
          <input type="number" name="subjects[${subjectCount}][exam]" min="0" max="70" required>
        </div>
        <div class="form-group">
          <button type="button" onclick="removeSubject(this)" class="btn btn-delete btn-sm">
            <i class="fa fa-trash"></i>
          </button>
        </div>
      </div>
    `;
        container.appendChild(newSubject);
        subjectCount++;
      }

      // Remove a subject entry and optionally re-index
      function removeSubject(button) {
        button.closest(".subject-entry").remove();
        reindexSubjects();
      }

      // Re-index subject input names after adding/removing
      function reindexSubjects() {
        const entries = document.querySelectorAll(".subject-entry");
        entries.forEach((entry, index) => {
          entry.querySelectorAll("input").forEach((input) => {
            if (input.name.includes("[name]"))
              input.name = `subjects[${index}][name]`;
            if (input.name.includes("[ca1]"))
              input.name = `subjects[${index}][ca1]`;
            if (input.name.includes("[ca2]"))
              input.name = `subjects[${index}][ca2]`;
            if (input.name.includes("[exam]"))
              input.name = `subjects[${index}][exam]`;
          });
        });
        subjectCount = entries.length;
      }

      // Student Search and Sort Functionality
      const studentSearch = document.getElementById('studentSearch');
      const studentSelect = document.getElementById('studentId');
      const clearSearchBtn = document.getElementById('clearSearch');
      const noResults = document.getElementById('noResults');
      const studentCount = document.getElementById('studentCount');
      const sortButtons = document.querySelectorAll('.sort-btn');

      let currentSort = 'name-asc';
      let allOptions = []; // Store all options for sorting

      // Initialize options array
      function initializeOptions() {
        allOptions = Array.from(studentSelect.options).filter(opt => opt.value);
      }

      // Sort students
      function sortStudents(sortType) {
        currentSort = sortType;
        
        // Update active button
        sortButtons.forEach(btn => {
          if (btn.dataset.sort === sortType) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });

        // Clone and sort options
        const sortedOptions = [...allOptions].sort((a, b) => {
          let compareA, compareB;

          switch(sortType) {
            case 'name-asc':
              compareA = a.dataset.name;
              compareB = b.dataset.name;
              return compareA.localeCompare(compareB);
            
            case 'name-desc':
              compareA = a.dataset.name;
              compareB = b.dataset.name;
              return compareB.localeCompare(compareA);
            
            case 'class-asc':
              // Smart class sorting: JSS1, JSS2, JSS3, SSS1, SSS2, SSS3
              const getClassOrder = (classStr) => {
                // Normalize: remove spaces, convert to lowercase
                const normalized = classStr.toLowerCase().replace(/\s+/g, '');
                
                // Match JSS patterns (jss1, jss 1, JSS 1, etc.)
                const jssMatch = normalized.match(/jss(\d+)/);
                if (jssMatch) {
                  const level = parseInt(jssMatch[1]);
                  return 1000 + level; // JSS1=1001, JSS2=1002, JSS3=1003
                }
                
                // Match SSS patterns (sss1, sss 1, SSS 1, etc.)
                const sssMatch = normalized.match(/sss(\d+)/);
                if (sssMatch) {
                  const level = parseInt(sssMatch[1]);
                  return 2000 + level; // SSS1=2001, SSS2=2002, SSS3=2003
                }
                
                // For any other class format, put at end and sort alphabetically
                return 9000;
              };
              
              const orderA = getClassOrder(a.dataset.class);
              const orderB = getClassOrder(b.dataset.class);
              
              if (orderA !== orderB) {
                return orderA - orderB;
              }
              
              // If same class, sort alphabetically by name
              return a.dataset.name.localeCompare(b.dataset.name);
            
            case 'reg-asc':
              compareA = a.dataset.reg;
              compareB = b.dataset.reg;
              return compareA.localeCompare(compareB);
            
            default:
              return 0;
          }
        });

        // Clear select (except placeholder)
        while (studentSelect.options.length > 1) {
          studentSelect.remove(1);
        }

        // Add sorted options
        sortedOptions.forEach(option => {
          studentSelect.add(option.cloneNode(true));
        });

        // Update allOptions with new sorted order
        allOptions = Array.from(studentSelect.options).filter(opt => opt.value);
        
        // Reapply current filter if any
        filterStudents();
      }

      // Update student count
      function updateStudentCount() {
        const visibleOptions = Array.from(studentSelect.options).filter(
          opt => opt.value && opt.style.display !== 'none'
        );
        const total = allOptions.length;
        
        if (studentSearch.value.trim()) {
          studentCount.textContent = `Showing ${visibleOptions.length} of ${total} students`;
        } else {
          studentCount.textContent = `${total} students available`;
        }
      }

      // Filter students based on search
      function filterStudents() {
        const searchTerm = studentSearch.value.toLowerCase().trim();
        let visibleCount = 0;

        Array.from(studentSelect.options).forEach(option => {
          if (!option.value) return; // Skip placeholder

          const name = option.dataset.name || '';
          const classLevel = option.dataset.class || '';
          const regNumber = option.dataset.reg || '';

          const matches = name.includes(searchTerm) || 
                         classLevel.includes(searchTerm) || 
                         regNumber.includes(searchTerm);

          if (matches) {
            option.style.display = '';
            visibleCount++;
          } else {
            option.style.display = 'none';
          }
        });

        // Show/hide no results message
        if (visibleCount === 0 && searchTerm) {
          noResults.style.display = 'block';
          studentSelect.style.display = 'none';
        } else {
          noResults.style.display = 'none';
          studentSelect.style.display = 'block';
        }

        // Show/hide clear button
        if (searchTerm) {
          clearSearchBtn.classList.add('show');
        } else {
          clearSearchBtn.classList.remove('show');
        }

        updateStudentCount();
      }

      // Clear search
      function clearSearch() {
        studentSearch.value = '';
        filterStudents();
        studentSearch.focus();
      }

      // Event listeners
      studentSearch.addEventListener('input', filterStudents);
      clearSearchBtn.addEventListener('click', clearSearch);

      // Sort button listeners
      sortButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          sortStudents(btn.dataset.sort);
        });
      });

      // Initialize
      initializeOptions();
      updateStudentCount();

      // AJAX form submission
      document
        .getElementById("resultForm")
        .addEventListener("submit", async (e) => {
          e.preventDefault();

          const formData = new FormData(e.target);

          // Collect subjects dynamically from DOM
          const subjects = [];
          document.querySelectorAll(".subject-entry").forEach((entry) => {
            const name = entry.querySelector('[name$="[name]"]').value.trim();
            const ca1 = parseInt(entry.querySelector('[name$="[ca1]"]').value);
            const ca2 = parseInt(entry.querySelector('[name$="[ca2]"]').value);
            const exam = parseInt(
              entry.querySelector('[name$="[exam]"]').value
            );

            if (name) {
              subjects.push({ name, ca1, ca2, exam });
            }
          });

          if (subjects.length === 0) {
            alert("Please add at least one subject with scores.");
            return;
          }

          const data = {
            studentId: formData.get("studentId"),
            term: formData.get("term"),
            session: formData.get("session"),
            subjects,
            teacherRemark: formData.get("teacherRemark"),
            headRemark: formData.get("headRemark"),
          };

          // Get admin token from EJS
          const adminToken = "<%= adminToken %>";

          try {
            const response = await fetch("/api/results", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                Authorization: `Bearer ${adminToken}`,
              },
              body: JSON.stringify(data),
            });

            const result = await response.json();

            if (response.ok) {
              alert("Result uploaded successfully!");
              window.location.href = "/admin/results";
            } else {
              alert("Error: " + result.message);
            }
          } catch (error) {
            alert("Upload failed: " + error.message);
          }
        });

    // Sidebar toggle for mobile
    const menuBtn = document.getElementById('menuBtn');
    const sidebar = document.getElementById('sidebar');
    menuBtn.addEventListener('click', () => {
      sidebar.classList.toggle('active');
    });
    </script>
  </body>
</html>
